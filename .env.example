# Application
POLYMARKET_ARB_ENV=dev
POLYMARKET_ARB_LOG_LEVEL=INFO
POLYMARKET_ARB_LOG_JSON=false

# Database
POLYMARKET_ARB_DATABASE_URL=sqlite+aiosqlite:///./polymarket_arb.db

# Discovery / selection
POLYMARKET_ARB_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_ARB_CLOB_BASE_URL=https://clob.polymarket.com
POLYMARKET_ARB_MIN_LIQUIDITY=0
POLYMARKET_ARB_CATEGORY=
POLYMARKET_ARB_SLUG_CONTAINS=
POLYMARKET_ARB_MAX_MARKETS=50

# Runtime
POLYMARKET_ARB_STALE_TIMEOUT_SECONDS=20
POLYMARKET_ARB_SIGNAL_NET_EDGE_BPS_THRESHOLD=15
POLYMARKET_ARB_TAKER_FEE_BPS=10
POLYMARKET_ARB_ESTIMATED_SLIPPAGE_BPS=5
POLYMARKET_ARB_QUEUE_PENALTY_BPS=3
POLYMARKET_ARB_STALE_DATA_PENALTY_BPS=10
POLYMARKET_ARB_SCAN_INTERVAL_SECONDS=5
POLYMARKET_ARB_PAPER_LOOP_SECONDS=2

# Paper risk
POLYMARKET_ARB_MAX_NOTIONAL_PER_MARKET=200
POLYMARKET_ARB_MAX_TOTAL_NOTIONAL=1000
POLYMARKET_ARB_MAX_DRAWDOWN=150

# Feature flags
POLYMARKET_ARB_ENABLE_LIVE_TRADING=false
